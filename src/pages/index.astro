---
export const prerender = false;

import '@fontsource-variable/inter';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '../styles/global.css';
import Dashboard from '../components/Dashboard.jsx';
import { loadSnapshotHistory } from '../lib/loadWorkbooks.js';
import { env } from 'cloudflare:workers';

// Load snapshot history from R2 storage (most recent MAX_HISTORY_SNAPSHOTS files).
const bucket = env.POKEMON_DATA;
const { snapshots, skipped, error } = await loadSnapshotHistory(bucket);
const latest = snapshots.at(-1); // most recent, since snapshots is ascending
const initialSheets = latest ? latest.sheets : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#e9edf4" />
    <title>Pokémon investments — portfolio dashboard</title>
    <meta name="description" content="Portfolio analytics for sealed Pokémon TCG holdings." />
  </head>
  <body>
    <main class="shell">
      <Dashboard
        client:load
        initialSheets={initialSheets}
        loadError={error}
        snapshots={snapshots}
        skipped={skipped}
      />
    </main>
  </body>
</html>
