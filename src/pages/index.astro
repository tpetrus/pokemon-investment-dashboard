---
export const prerender = false;

import '@fontsource-variable/inter';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '../styles/global.css';
import Dashboard from '../components/Dashboard.jsx';
import { loadWorkbooks } from '../lib/loadWorkbooks.js';
import { env } from 'cloudflare:workers';

// Load spreadsheets from R2 storage
const bucket = env.POKEMON_DATA;
const { sheets, dir, error } = await loadWorkbooks(bucket);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>Pokémon investments — portfolio dashboard</title>
    <meta name="description" content="Portfolio analytics for sealed Pokémon TCG holdings." />
  </head>
  <body>
    <main class="shell">
      <Dashboard client:load initialSheets={sheets} dir={dir} loadError={error} />
    </main>
  </body>
</html>
